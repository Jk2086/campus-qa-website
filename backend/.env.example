# CAMPUS-Q&A Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=campus-qa-super-secret-jwt-key-2026-production
JWT_EXPIRES_IN=7d

# Institution Specific Validation (Exclusive Campus Access)
INSTITUTION_EMAIL_DOMAIN=university.edu
INSTITUTION_NAME=Northfield Institute of Technology
STRICT_INSTITUTION_DOMAIN=false

# PostgreSQL Database Configuration
# Leave empty to automatically use embedded in-memory PostgreSQL (pg-mem) for instant zero-config testing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_qa
USE_IN_MEMORY_DB=false

# CORS Configuration
CORS_ORIGIN=*

# AI Assistant Configuration (Optional: uses robust offline Answer-Guide-Connect pipeline if not set)
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
